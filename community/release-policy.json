{
  "schemaVersion": 1,
  "productCharter": "AXSDK installs, manages, and runs user-selected community web-automation scripts on websites explicitly authorized by the user. This policy describes the REVIEWED Chrome Web Store artifact, whose install path is the signed registry: the unsigned install-from-a-URL surface exists in the development build only and is removed at build time, which `assertNoUrlInstallSurface` proves on every packaged build.",
  "browser": {
    "minimumChromeVersion": 138,
    "executionApi": "chrome.userScripts",
    "world": "USER_SCRIPT"
  },
  "artifacts": {
    "executionLanguage": "javascript",
    "acceptedAuthoringLanguages": [
      "javascript",
      "lua"
    ],
    "luaPublication": "embedded_source_in_signed_wrapper",
    "luaInterpreter": "packaged",
    "dynamicLuaLoad": false,
    "remoteInterpreter": false
  },
  "approvals": {
    "install": "always",
    "enable": "always",
    "update": "always",
    "hostExpansion": "always",
    "capabilityExpansion": "always"
  },
  "updates": {
    "automatic": false,
    "atomicRollback": true
  },
  "trust": {
    "registryReviewed": true,
    "registrySigned": true,
    "arbitraryUrlImport": false,
    "unsignedScripts": false
  },
  "effects": {
    "allowed": [
      "read",
      "page_write",
      "external_send",
      "cart_mutation"
    ],
    "forbidden": [
      "purchase",
      "order_placement",
      "payment"
    ]
  },
  "modelMayManageScripts": false
}
