{
  "name": "axsdk-sites",
  "version": "0.0.0",
  "private": true,
  "description": "Site-specific llms.txt sitemap data and AXSDK Lua scripts for the AXSDK Chrome extension.",
  "scripts": {
    "build:lua": "node tools/merge-lua.mjs",
    "build:lua:self-contained": "node tools/merge-lua.mjs --self-contained",
    "build:lua:check": "node tools/merge-lua.mjs --check",
    "build:bundle": "node tools/build-workspace-assets.mjs",
    "check:community-policy": "node tools/community-release-policy.mjs --check",
    "probe:packs:phase0:platform": "node tools/pack-phase0-platform.mjs",
    "check:community-registry": "node tools/community-registry.mjs --check",
    "build:cws": "npm run check:community-policy && npm run check:community-registry && npm run build:bundle && npm run build:bundle -- --out=../axsdk-sdk-js/packages/axsdk-extension-cdp/workspace-manifest.json && npm --prefix ../axsdk-sdk-js/packages/axsdk-extension-cdp run build:cws",
    "release:cws": "npm run build:cws && node tools/build-cws-release.mjs",
    "test:cws:artifact": "npm run build:cws && node tools/scenarios/cws-artifact-smoke.mjs",
    "check:bundle": "node tools/build-workspace-assets.mjs --check",
    "check:flows": "node --test \"tools/*.test.mjs\"",
    "test:lua": "node --test \"tools/lua/*.test.mjs\"",
    "test:playground": "node --test \"tools/harness/*.test.mjs\" \"tools/playground/*.test.mjs\"",
    "test:commerce": "bun tools/test_multi_store_total_cost.mjs && bun tools/test_representative_commerce_sites.mjs",
    "test:commerce:sites": "bun tools/test_representative_commerce_sites.mjs",
    "test:commerce:live": "node tools/scenarios/multi-store-total-cost.mjs",
    "test:commerce:live:all": "node tools/scenarios/commerce-all-sites.mjs",
    "test:commerce:live:expanded": "node tools/scenarios/multi-store-total-cost.mjs --cancel --stores=11st,walmart",
    "test:commerce:live:discovery": "node tools/scenarios/multi-store-total-cost.mjs --discover --cancel --stores=11st,walmart",
    "test:thumbtack:live": "node tools/scenarios/thumbtack-quote.mjs",
    "cdp": "node ../axsdk-sdk-js/packages/axsdk-extension-cdp/scripts/harness.mjs",
    "chrome": "node ../axsdk-sdk-js/packages/axsdk-extension-cdp/scripts/harness.mjs",
    "repl": "node ../axsdk-sdk-js/packages/axsdk-extension-cdp/scripts/harness.mjs repl",
    "ax": "node tools/ax.mjs",
    "chrome:legacy": "node tools/ax.mjs chrome",
    "repl:legacy": "node tools/ax.mjs repl",
    "build:rpc": "npm run build:rpc:sites && node tools/build-rpc-flows.mjs playground",
    "package:verify": "node tools/rpc-package.mjs verify",
    "package:push": "node tools/rpc-package.mjs push",
    "build:rpc:sites": "node tools/build-rpc-sites.mjs && node tools/build-rpc-sites.mjs playground/_common/rpc/17_rpc_sites.lua",
    "measure:rpc": "node tools/measure-rpc.mjs",
    "probe:client-modules": "node tools/probe-client-modules.mjs",
    "build:schema": "node tools/build-schema.mjs",
    "dead:lua": "node tools/dead-lua.mjs",
    "test:playground:live": "node tools/scenarios/playground-live.mjs",
    "test:scenarios": "node --test \"tools/scenarios/*.test.mjs\"",
    "test:packs": "bun test tools/packs",
    "test:commerce:live:cart": "node tools/scenarios/cart-live.mjs",
    "test:extraction:live": "node tools/scenarios/extraction-audit-live.mjs",
    "check:listing": "node tools/listing.mjs"
  },
  "devDependencies": {
    "fengari": "^0.1.4",
    "yaml": "2.9.0"
  }
}
